# ============================================================
# ANTARCTIC NAV-X configuration
# Copy this file to .env. Never commit a real .env file.
# ============================================================

# ---------------------- DATABASE ----------------------------
# Zero-setup local development (default if DATABASE_URL is omitted):
#   sqlite:///data/navx.db   (created automatically by NAV-X)
#
# Recommended production / team database:
# DATABASE_URL=postgresql+psycopg://navx_user:CHANGE_ME@localhost:5432/navx_db
DATABASE_URL=

# ---------------- AUTOMATIC INGESTION -----------------------
AUTO_INGESTION_ENABLED=true
# Protects expensive manual POST ingestion endpoints. Leave blank to disable them.
NAVX_ADMIN_TOKEN=
AIS_DB_SNAPSHOT_SECONDS=30
USNIC_REFRESH_MINUTES=30

# Historical iceberg archive: published BYU/NIC consolidated tracks.
# Current hazards still use the official current USNIC table.
AUTO_FETCH_ICEBERG_HISTORY=true
BYU_HISTORY_REFRESH_DAYS=7
BYU_ICEBERG_HISTORY_URL=

# Genuine-AIS-only unsupervised anomaly model. The scheduler retrains when
# enough new real AIS observations have accumulated.
AUTO_TRAIN_AIS_ANOMALY=true
AIS_ANOMALY_TRAIN_MINUTES=15
AIS_ANOMALY_MIN_SAMPLES=30
AIS_ANOMALY_MIN_VESSELS=2
NSIDC_REFRESH_HOURS=6
NDBC_REFRESH_MINUTES=10
AUTO_FETCH_SENTINEL1=true
SENTINEL_REFRESH_HOURS=6
SENTINEL_LOOKBACK_HOURS=24
AUTO_FETCH_CMEMS=true
CMEMS_REFRESH_UTC_HOUR=2
AUTO_FETCH_ERA5=true
ERA5_REFRESH_UTC_HOUR=3

# ------------------------- MAP ------------------------------
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Legacy compatibility only; the supplied map does not require Mappls.
MAPPLS_STATIC_KEY=

# ---------------------- LIVE AIS ----------------------------
# Choose: auto | aisstream | aishub | datalastic
# No configured provider = zero vessels. NAV-X never invents ships.
AIS_PROVIDER=auto
AISSTREAM_API_KEY=226fda770229b3f3f44cc91290c59c53996a1bda
AISHUB_USERNAME=nox203-source
AISHUB_POLL_SECONDS=65
DATALASTIC_API_KEY=
DATALASTIC_CACHE_SECONDS=120
AIS_MIN_LAT=-45
AIS_MAX_POSITION_AGE_MINUTES=180
AIS_CACHE_HOURS=6

# ------------------ COPERNICUS MARINE -----------------------
# Preferred official names for automated/headless Toolbox access.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# Legacy aliases are still accepted by NAV-X for compatibility.
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=

# ------------------------ ERA5 / CDS ------------------------
# Preferred: create %USERPROFILE%\.cdsapirc using the token from your CDS profile.
# cdsapi also supports these environment variables:
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=


# --------------- SENTINEL-1 / CDSE -------------------------
# Create an OAuth Client in the Copernicus Data Space / Sentinel Hub dashboard.
# NAV-X currently persists real Sentinel-1 GRD catalogue metadata only; it does
# not falsely claim that a SAR scene was downloaded or analysed.
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# -------------------- NOAA NDBC -----------------------------
# Public latest-observations HTTPS feed; no API key is required.
NDBC_MIN_LAT=-45

# ------------------- NASA EARTHDATA -------------------------
# Optional credential placeholder for a future *specific* NASA data product.
# Earthdata Login is authentication, not a dataset by itself.
EARTHDATA_TOKEN=

# ----------------------- SERVER -----------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=
